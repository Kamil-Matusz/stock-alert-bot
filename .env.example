# Supabase Configuration (Project Settings -> API Keys)

# Backend (bot) - secret key, bypasses RLS. Never expose it to the frontend.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=sb_secret_...

# Frontend - only VITE_* variables are bundled into the browser code.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Telegram (optional) - bot token from @BotFather, chat id from getUpdates
TELEGRAM_BOT_TOKEN=123456789:AA...
TELEGRAM_CHAT_ID=123456789
